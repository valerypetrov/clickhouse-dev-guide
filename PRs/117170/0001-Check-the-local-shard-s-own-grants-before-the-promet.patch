 .../resolvePrometheusQueryTarget.cpp          |  9 ++
 .../TimeSeries/resolvePrometheusQueryTarget.h |  4 +-
 .../test_local_shard_distributed.py           | 90 +++++++++++++++++++
 4 files changed, 102 insertions(+), 3 deletions(-)

diff --git a/docs/concepts/features/interfaces/prometheus.mdx b/docs/concepts/features/interfaces/prometheus.mdx
index 686e6401f..c41ee1816 100644
--- a/docs/concepts/features/interfaces/prometheus.mdx
+++ b/docs/concepts/features/interfaces/prometheus.mdx
@@ -86,7 +86,7 @@ ClickHouse implements the Prometheus HTTP API over a [`TimeSeries`](/reference/e
 
 The query endpoints, remote write, and the `prometheusQuery`/`prometheusQueryRange` table functions also accept a `Distributed` table over per-shard `TimeSeries` tables: samples are selected on every shard and the PromQL is evaluated on the initiator, and writes are routed through the `Distributed` sink. Remote read and the metadata endpoints (`/api/v1/series`, `/api/v1/labels`, `/api/v1/label/<name>/values`, `/api/v1/metadata`) remain `TimeSeries`-only and refuse a `Distributed` target.
 
-Every shard-local table behind such a `Distributed` table must be a `TimeSeries` table declaring the same `time_series` type as the `Distributed` table itself; a mismatch is refused rather than rounded, and the check asks every replica of every shard on every request, so a shard-local table swapped for another under the same name is caught by the next request rather than written into. A read is not failed by a replica the check cannot reach or that has no table of that name: whether the read itself fails is decided, as before, by its own `skip_unavailable_shards` settings. Remote write, however, is refused (with a retryable `5xx`) while any replica is unreachable, has no table of that name, or does not show that table's `time_series` type, because a replica the check could not see would still receive the samples unchecked. When the `Distributed` table declares no database, each shard resolves the name in its own default database, except a shard that is this server itself, which resolves it in the requesting user's current database, exactly as any query here would. Reading through it needs `SELECT` on the `Distributed` table and `READ ON REMOTE`, because the query is rewritten into a `cluster()` call; both are checked before the shard-local check above runs, so a caller without either is refused with a plain access error rather than told what the shards hold. The `prometheusQuery`/`prometheusQueryRange` table functions need `CREATE TEMPORARY TABLE` on top of those, as they do over a `TimeSeries` table; the query endpoints name the selector inside the `cluster()` call for each shard to resolve, so they need it only for a shard that is this server itself. Writing needs `INSERT` on the `Distributed` table only.
+Every shard-local table behind such a `Distributed` table must be a `TimeSeries` table declaring the same `time_series` type as the `Distributed` table itself; a mismatch is refused rather than rounded, and the check asks every replica of every shard on every request, so a shard-local table swapped for another under the same name is caught by the next request rather than written into. A read is not failed by a replica the check cannot reach or that has no table of that name: whether the read itself fails is decided, as before, by its own `skip_unavailable_shards` settings. Remote write, however, is refused (with a retryable `5xx`) while any replica is unreachable, has no table of that name, or does not show that table's `time_series` type, because a replica the check could not see would still receive the samples unchecked. When the `Distributed` table declares no database, each shard resolves the name in its own default database, except a shard that is this server itself, which resolves it in the requesting user's current database, exactly as any query here would. Reading through it needs `SELECT` on the `Distributed` table and `READ ON REMOTE`, because the query is rewritten into a `cluster()` call; both are checked before the shard-local check above runs, so a caller without either is refused with a plain access error rather than told what the shards hold. The `prometheusQuery`/`prometheusQueryRange` table functions need `CREATE TEMPORARY TABLE` on top of those, as they do over a `TimeSeries` table; the query endpoints name the selector inside the `cluster()` call for each shard to resolve, so they need it only for a shard that is this server itself, together with `SELECT` on that shard's table; both are checked before the shard-local check runs too. Writing needs `INSERT` on the `Distributed` table only.
 
 Remote write into a `Distributed` target is an `INSERT` through that table's sink with [`distributed_foreground_insert`](/reference/settings/session-settings/distributed#distributed_foreground_insert) forced on and [`async_insert`](/reference/settings/session-settings/async-insert#async_insert) forced off, whatever the handler's user profile or the `remote_write` URL says: the samples are not queued on the initiator, by the sink or by the asynchronous insert queue, but delivered to the shards before the response, so a `204` means every shard (one replica per shard under `internal_replication`) has accepted them, and a shard that fails the insert fails the write with a retryable `5xx`, which Prometheus answers by resending the batch. A batch left in either queue would be flushed after the check above, into whatever answers to the shard-local name by then, which is why background delivery is not offered on this path. [`skip_unavailable_shards`](/reference/settings/session-settings/skip-unavailable-shards#skip_unavailable_shards) is forced off on this path too, whatever the URL or the profile says: a shard the sink skipped would be samples dropped under a `204`. The routing settings `insert_shard_id` and `insert_distributed_one_random_shard` are refused on this path, whether they come from the URL or from the profile: a batch goes where the table's sharding key sends it, so a `Distributed` table with several shards and no key cannot be written through remote write.
 
diff --git a/src/Storages/TimeSeries/resolvePrometheusQueryTarget.cpp b/src/Storages/TimeSeries/resolvePrometheusQueryTarget.cpp
index eeb352d5f..8eccc23fa 100644
--- a/src/Storages/TimeSeries/resolvePrometheusQueryTarget.cpp
+++ b/src/Storages/TimeSeries/resolvePrometheusQueryTarget.cpp
@@ -28,6 +28,7 @@
 
 #include <fmt/ranges.h>
 
+#include <algorithm>
 #include <set>
 
 
@@ -284,6 +285,14 @@ void checkPrometheusQueryDistributedRead(const IStorage & storage, const Context
     /// cluster() call enforces only later is required here, before it can report on a shard-local target.
     context->checkAccess(AccessType::READ, AccessTypeObjects::toStringSource(AccessTypeObjects::Source::REMOTE));
 
+    /// A shard that is this server itself is read in-process, on the caller's context: its selector's grants too.
+    const auto cluster = typeid_cast<const StorageDistributed &>(storage).getCluster();
+    if (std::ranges::any_of(cluster->getShardsInfo(), &Cluster::ShardInfo::isLocal))
+    {
+        context->checkAccess(AccessType::SELECT, context->resolveStorageID(target->remote_time_series_storage_id));
+        context->checkAccess(AccessType::CREATE_TEMPORARY_TABLE);
+    }
+
     /// Whether an unavailable replica fails the read is the read's own decision, as for any cluster() call.
     checkShardTargets(storage, *target, context, /* refuse_unavailable = */ false);
 }
diff --git a/src/Storages/TimeSeries/resolvePrometheusQueryTarget.h b/src/Storages/TimeSeries/resolvePrometheusQueryTarget.h
index 53de08cda..27b6f4798 100644
--- a/src/Storages/TimeSeries/resolvePrometheusQueryTarget.h
+++ b/src/Storages/TimeSeries/resolvePrometheusQueryTarget.h
@@ -34,8 +34,8 @@ void checkNoBypassedReadRestriction(
 /// The wrapper's SELECT grant (table functions are exempt from the planner's check), then what a plain SELECT through
 /// it would apply and the rewrite cannot (its row policy, filters keyed to it; the shard-local table's are checked by
 /// the selector on each shard), then READ ON REMOTE, which the generated cluster() call would enforce only later,
-/// then every replica's shard-local target: a TimeSeries table declaring the wrapper's `time_series` type, or the
-/// read is refused.
+/// then, for a shard that is this server itself, the selector's own SELECT and CREATE TEMPORARY TABLE, then every
+/// replica's shard-local target: a TimeSeries table declaring the wrapper's `time_series` type, or the read is refused.
 void checkPrometheusQueryDistributedRead(const IStorage & storage, const ContextPtr & context);
 
 /// The same targets for a write, refused while any replica is unreachable, has no such table or does not show its
diff --git a/tests/integration/test_prometheus_protocols/test_local_shard_distributed.py b/tests/integration/test_prometheus_protocols/test_local_shard_distributed.py
index 73165ece3..e0e74716a 100644
--- a/tests/integration/test_prometheus_protocols/test_local_shard_distributed.py
+++ b/tests/integration/test_prometheus_protocols/test_local_shard_distributed.py
@@ -13,6 +13,7 @@ from helpers.test_tools import assert_eq_with_retry
 from .prometheus_test_utils import (
     convert_time_series_to_protobuf,
     execute_query_via_http_api,
+    execute_range_query_via_http_api,
     get_response_to_remote_write,
     send_protobuf_to_remote_write,
 )
@@ -38,6 +39,18 @@ START_TIME = 1724112000
 CALLER = "?user=prom_metrics&password="
 CALLER_PARAMS = {"user": "prom_metrics", "password": ""}
 
+# Callers whose current database is `default`, where `ts_local` is the MergeTree table, each
+# missing one grant that the in-process read of the local shard enforces.
+NO_TEMP_TABLE_USER = "prom_no_temp_table"
+NO_SHARD_SELECT_USER = "prom_no_shard_select"
+RESTRICTED_CALLERS = [
+    (NO_TEMP_TABLE_USER, "CREATE TEMPORARY TABLE"),
+    (NO_SHARD_SELECT_USER, "SELECT ON default.ts_local"),
+]
+
+# What the shard probe says about that table, in the words no denied caller may see.
+SHARD_LOCAL_LEAK = ["shard-local", "not TimeSeries", "UNEXPECTED_TABLE_ENGINE"]
+
 
 @pytest.fixture(scope="module", autouse=True)
 def start_cluster():
@@ -65,6 +78,14 @@ def start_cluster():
             "CREATE TABLE default.prom_swap AS default.ts_swap "
             "ENGINE = Distributed(local_shard_dist, '', ts_swap)"
         )
+
+        # Both may read the wrapper and call cluster(); each lacks one grant of the local shard's read.
+        for user, _ in RESTRICTED_CALLERS:
+            node.query(f"CREATE USER {user} IDENTIFIED WITH no_password")
+            node.query(f"GRANT READ ON REMOTE TO {user}")
+        node.query(f"GRANT SELECT ON *.* TO {NO_TEMP_TABLE_USER}")
+        node.query(f"GRANT SELECT ON metrics.prom_local TO {NO_SHARD_SELECT_USER}")
+        node.query(f"GRANT CREATE TEMPORARY TABLE ON *.* TO {NO_SHARD_SELECT_USER}")
         yield cluster
     finally:
         cluster.shutdown()
@@ -116,3 +137,72 @@ def test_remote_write_is_refused_when_only_the_probes_database_is_healthy():
     assert "UNEXPECTED_TABLE_ENGINE" in response.text
     assert int(node.query("SELECT count() FROM metrics.ts_swap")) == 0
     assert int(node.query("SELECT count() FROM timeSeriesTags(default.ts_swap)")) == 0
+
+
+def query_as(endpoint, user):
+    """The error of the instant or range PromQL endpoint for a caller of this name."""
+    params = {"user": user, "password": ""}
+    if endpoint == "query":
+        return execute_query_via_http_api(
+            node.ip_address,
+            9093,
+            "/local_api/query",
+            "local_metric",
+            START_TIME,
+            params=params,
+            expect_error=True,
+        )
+    return execute_range_query_via_http_api(
+        node.ip_address,
+        9093,
+        "/local_api/query_range",
+        "local_metric",
+        START_TIME,
+        START_TIME + 10,
+        "10",
+        params=params,
+        expect_error=True,
+    )
+
+
+def assert_denied_without_leaking(error, grant):
+    assert "Not enough privileges" in error, error
+    assert grant in error, error
+    for fragment in SHARD_LOCAL_LEAK:
+        assert fragment not in error, error
+
+
+@pytest.mark.parametrize("user, grant", RESTRICTED_CALLERS)
+@pytest.mark.parametrize("endpoint", ["query", "query_range"])
+def test_query_endpoints_deny_the_local_shard_grants_before_probing(
+    endpoint, user, grant
+):
+    """The local shard is read in-process, so its selector enforces the caller's grants on the table
+    it resolves: those are checked before the probe, which would otherwise describe that table.
+    """
+    # A caller holding every grant is told what the probe found under its own database...
+    allowed = query_as(endpoint, "default")
+    assert "are not TimeSeries tables" in allowed, allowed
+
+    # ...while one missing a grant the local shard needs later learns only that it has no grant.
+    assert_denied_without_leaking(query_as(endpoint, user), grant)
+
+
+@pytest.mark.parametrize("user, grant", RESTRICTED_CALLERS)
+@pytest.mark.parametrize(
+    "table_function",
+    [
+        f"prometheusQuery(metrics.prom_local, 'local_metric', {START_TIME})",
+        f"prometheusQueryRange(metrics.prom_local, 'local_metric', {START_TIME}, {START_TIME + 10}, 10)",
+    ],
+)
+def test_table_functions_deny_the_local_shard_grants_before_probing(
+    table_function, user, grant
+):
+    sql = f"SELECT count() FROM {table_function}"
+    allowed = node.query_and_get_error(sql)
+    assert "are not TimeSeries tables" in allowed, allowed
+
+    # The client prints the server's stack trace after the message; its frames name source files.
+    denied = node.query_and_get_error(sql, user=user).split("Stack trace:")[0]
+    assert_denied_without_leaking(denied, grant)
