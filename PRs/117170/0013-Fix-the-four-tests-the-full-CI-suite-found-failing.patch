index 5bb75934e54..631d23c1d1d 100644
--- a/tests/integration/test_prometheus_protocols/test_access_distributed.py
+++ b/tests/integration/test_prometheus_protocols/test_access_distributed.py
@@ -199,7 +199,7 @@ def test_remote_read_needs_the_select_grant():
         node.ip_address, 9093, f"{DIST}/read", read_request
     )
     assert allowed.headers["X-ClickHouse-Exception-Code"] == error_code(
-        "NOT_IMPLEMENTED"
+        node, "NOT_IMPLEMENTED"
     )
 
     # The restricted caller is stopped before that, so the refusal never reaches it.
diff --git a/tests/integration/test_prometheus_protocols/test_local_shard_distributed.py b/tests/integration/test_prometheus_protocols/test_local_shard_distributed.py
index 4701d0a2b00..50f0f189262 100644
